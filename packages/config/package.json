{
  "name": "@underpin/config",
  "version": "1.12.4",
  "description": "Shared linter configurations and release tooling for TypeScript projects.",
  "homepage": "https://github.com/underpinhq/underpin/tree/main/packages/config#readme",
  "bugs": {
    "url": "https://github.com/underpinhq/underpin/issues"
  },
  "license": "MIT",
  "author": "Piotr Kulpinski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/underpinhq/underpin.git",
    "directory": "packages/config"
  },
  "bin": {
    "kodeks": "./bin/underpin.js",
    "underpin": "./bin/underpin.js"
  },
  "files": [
    "bin",
    "configs",
    "!configs/*.test.ts",
    "dist",
    "skills"
  ],
  "type": "module",
  "exports": {
    "./oxlint": {
      "types": "./dist/configs/oxlint-base.d.ts",
      "default": "./dist/configs/oxlint-base.js"
    },
    "./oxlint-next": {
      "types": "./dist/configs/oxlint-next.d.ts",
      "default": "./dist/configs/oxlint-next.js"
    },
    "./oxlint-tanstack": {
      "types": "./dist/configs/oxlint-tanstack.d.ts",
      "default": "./dist/configs/oxlint-tanstack.js"
    },
    "./oxlint-tailwind": {
      "types": "./dist/configs/oxlint-tailwind.d.ts",
      "default": "./dist/configs/oxlint-tailwind.js"
    },
    "./oxfmt": {
      "types": "./dist/configs/oxfmt.d.ts",
      "default": "./dist/configs/oxfmt.js"
    },
    "./commitlint": "./configs/commitlint.json",
    "./semantic-release": "./configs/semantic-release.json",
    "./semantic-release-dry-run": "./configs/semantic-release-dry-run.json",
    "./changesets-changelog": {
      "types": "./dist/configs/changesets-changelog.d.ts",
      "default": "./dist/configs/changesets-changelog.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@commitlint/cli": ">=21",
    "@commitlint/config-conventional": ">=21",
    "conventional-changelog-conventionalcommits": ">=10",
    "eslint-plugin-better-tailwindcss": ">=4",
    "lefthook": ">=2",
    "oxfmt": ">=0.58",
    "oxlint": ">=1.73",
    "semantic-release": ">=25",
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "@commitlint/cli": {
      "optional": true
    },
    "eslint-plugin-better-tailwindcss": {
      "optional": true
    },
    "@commitlint/config-conventional": {
      "optional": true
    },
    "conventional-changelog-conventionalcommits": {
      "optional": true
    },
    "lefthook": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "semantic-release": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
