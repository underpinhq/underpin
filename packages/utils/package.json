{
  "name": "@underpin/utils",
  "version": "3.4.0",
  "private": true,
  "description": "A lightweight set of utilities",
  "keywords": [
    "helpers",
    "typescript",
    "utilities",
    "utils"
  ],
  "homepage": "https://github.com/underpinhq/underpin/tree/main/packages/utils#readme",
  "bugs": "https://github.com/underpinhq/underpin/issues",
  "license": "MIT",
  "author": {
    "name": "Piotr Kulpinski",
    "email": "piotr@kulpinski.pl",
    "url": "https://kulpinski.pl"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/underpinhq/underpin.git",
    "directory": "packages/utils"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": "./dist/*/*.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "test:node": "vitest run"
  },
  "dependencies": {
    "@sindresorhus/slugify": "^3.0.1"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/bun": "^1.2.21",
    "esbuild": "^0.27.3",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
